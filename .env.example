# ---------- Core ----------
# Set to "production" when deploying. Enables secure cookies + error redaction.
NODE_ENV=development

# Port the HTTP server listens on (Render sets this automatically).
PORT=3000

# Public base URL of the site, used in emails & metadata. No trailing slash.
PUBLIC_URL=http://localhost:3000

# ---------- Database ----------
# Local Postgres. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# For a hosted DB (Render/Neon/Supabase) paste the connection string they give
# you. If your host requires TLS, append ?sslmode=require
DATABASE_URL=postgresql://kaggwaham@localhost:5432/nam_interior_constructs

# ---------- Security ----------
# REQUIRED in production. Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# How long an admin stays logged in, in hours.
SESSION_HOURS=12

# ---------- First admin account ----------
# Used by `npm run db:seed` to create your login. Change the password after.
ADMIN_EMAIL=admin@naminteriorconstructs.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Namusoke Administrator

# ---------- Email notifications (optional) ----------
# Leave MAIL_ENABLED=false to disable. Works with Resend, SendGrid, Gmail,
# Mailgun, Zoho, cPanel — anything that speaks SMTP.
MAIL_ENABLED=false
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=your-smtp-password
MAIL_FROM="Nam Interior Constructs <no-reply@naminteriorconstructs.com>"
# Where new-lead alerts are delivered.
MAIL_TO=info@naminteriorconstructs.com

# ---------- Business details (shown on the website) ----------
BUSINESS_PHONE=+256 700 000 000
BUSINESS_WHATSAPP=256700000000
BUSINESS_EMAIL=info@naminteriorconstructs.com
BUSINESS_ADDRESS=Kampala, Uganda
